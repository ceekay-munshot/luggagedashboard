{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luggagedashboard",
  "main": "worker.js",
  "compatibility_date": "2026-04-29",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "LUGGAGE_HISTORY_KV",
      "id": "2c94fcf4f4204db5a732a96049505952"
    }
  ]
}
